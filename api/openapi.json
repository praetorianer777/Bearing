{
  "openapi": "3.1.0",
  "info": {
    "title": "Bearing",
    "version": "1",
    "description": "The organisation modeling HTTP API. Every endpoint answers JSON; errors share one envelope. Partners check the capabilities at /meta rather than the build's version."
  },
  "servers": [
    {
      "url": "/api/v1",
      "description": "This deployment"
    }
  ],
  "tags": [
    {
      "name": "accounts"
    },
    {
      "name": "health"
    }
  ],
  "paths": {
    "/accounts": {
      "get": {
        "operationId": "accounts",
        "summary": "Every account.",
        "tags": [
          "accounts"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "accounts": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/AccountResponse"
                      }
                    }
                  },
                  "required": [
                    "accounts"
                  ]
                }
              }
            }
          },
          "default": {
            "description": "An error, in the one shape every endpoint uses.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "createAccount",
        "summary": "Make a local account with a password.",
        "tags": [
          "accounts"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateAccountRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "account": {
                      "$ref": "#/components/schemas/AccountResponse"
                    }
                  },
                  "required": [
                    "account"
                  ]
                }
              }
            }
          },
          "default": {
            "description": "An error, in the one shape every endpoint uses.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        }
      }
    },
