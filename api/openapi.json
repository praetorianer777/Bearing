{
  "openapi": "3.1.0",
  "info": {
    "title": "Bearing",
    "version": "1",
    "description": "The organisation modeling HTTP API. Every endpoint answers JSON; errors share one envelope. Partners check the capabilities at /meta rather than the build's version."
  },
  "servers": [
    {
      "url": "/api/v1",
      "description": "This deployment"
    }
  ],
  "tags": [
    {
      "name": "health"
    }
  ],
  "paths": {
    "/healthz": {
      "get": {
        "operationId": "liveness",
        "summary": "Whether the process is running.",
        "tags": [
          "health"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StatusResponse"
                }
              }
            }
          },
          "default": {
            "description": "An error, in the one shape every endpoint uses.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        },
        "servers": [
          {
            "url": "/",
            "description": "Outside the API's prefix"
          }
        ]
      }
    },
    "/meta": {
      "get": {
        "operationId": "meta",
        "summary": "Which product and build answers here, and the capabilities it offers partners.",
        "tags": [
          "health"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MetaResponse"
                }
              }
            }
          },
          "default": {
            "description": "An error, in the one shape every endpoint uses.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/openapi.json": {
      "get": {
        "operationId": "openapi",
        "summary": "This document.",
        "tags": [
          "health"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "description": "An OpenAPI 3.1 document."
                }
              }
            }
          },
          "default": {
            "description": "An error, in the one shape every endpoint uses.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/readyz": {
      "get": {
        "operationId": "readiness",
        "summary": "Whether the process can serve, and how reads are routed.",
        "tags": [
          "health"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadinessResponse"
                }
              }
            }
          },
          "503": {
            "description": "Service Unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "default": {
            "description": "An error, in the one shape every endpoint uses.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        },
        "servers": [
          {
            "url": "/",
            "description": "Outside the API's prefix"
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "APIError": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "fields": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "message": {
            "type": "string"
          },
          "requestId": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "message"
        ]
      },
      "ErrorEnvelope": {
        "type": "object",
        "properties": {
          "error": {
            "$ref": "#/components/schemas/APIError"
          }
        },
        "required": [
          "error"
        ]
      },
      "Info": {
        "type": "object",
        "properties": {
          "builtAt": {
            "type": "string"
          },
          "commit": {
            "type": "string"
          },
          "version": {
            "type": "string"
          }
        },
        "required": [
          "version"
        ]
      },
      "MetaResponse": {
        "type": "object",
        "properties": {
          "apiVersion": {
            "type": "string"
          },
          "build": {
            "$ref": "#/components/schemas/Info"
          },
          "capabilities": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "product": {
            "type": "string"
          }
        },
        "required": [
          "product",
          "build",
          "apiVersion",
          "capabilities"
        ]
      },
      "ReadinessResponse": {
        "type": "object",
        "properties": {
          "replicas": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ReplicaStatus"
            }
          },
          "status": {
            "type": "string"
          }
        },
        "required": [
          "status",
          "replicas"
        ]
      },
      "ReplicaStatus": {
        "type": "object",
        "properties": {
          "healthy": {
            "type": "boolean"
          },
          "lastError": {
            "type": "string"
          },
          "name": {
            "type": "string"
          }
        },
        "required": [
          "name",
          "healthy"
        ]
      },
      "StatusResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string"
          }
        },
        "required": [
          "status"
        ]
      }
    }
  }
}
