              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        },
        "servers": [
          {
            "url": "/",
            "description": "Outside the API's prefix"
          }
        ]
      }
    },
