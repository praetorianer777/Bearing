        "servers": [
          {
            "url": "/",
            "description": "Outside the API's prefix"
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "APIError": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "fields": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "message": {
            "type": "string"
          },
          "requestId": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "message"
        ]
      },
      "AcceptInvitationRequest": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "password": {
            "type": "string"
          }
        },
        "required": [
          "name",
          "password"
        ]
      },
      "AccountResponse": {
        "type": "object",
        "properties": {
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "disabled": {
            "type": "boolean"
          },
          "email": {
            "type": "string"
          },
          "hasPassword": {
            "type": "boolean"
          },
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "role": {
            "type": "string",
            "enum": [
              "administrator",
              "editor",
              "member",
              "reader"
            ]
          }
        },
        "required": [
          "id",
          "email",
          "name",
          "role",
          "disabled",
          "hasPassword",
          "createdAt"
        ]
      },
      "CreateAccountRequest": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "password": {
            "type": "string"
          },
          "role": {
            "type": "string",
            "enum": [
              "administrator",
              "editor",
              "member",
              "reader"
            ]
          }
        },
        "required": [
          "name",
          "email",
          "role",
          "password"
        ]
      },
      "ErrorEnvelope": {
        "type": "object",
        "properties": {
          "error": {
            "$ref": "#/components/schemas/APIError"
          }
        },
        "required": [
          "error"
        ]
      },
      "Info": {
        "type": "object",
        "properties": {
          "builtAt": {
            "type": "string"
          },
          "commit": {
            "type": "string"
          },
          "version": {
            "type": "string"
          }
        },
        "required": [
          "version"
        ]
      },
      "InstallationResponse": {
        "type": "object",
        "properties": {
          "mail": {
            "type": "boolean"
          },
          "name": {
            "type": "string"
          },
          "setUp": {
            "type": "boolean"
          }
        },
        "required": [
          "name",
          "setUp",
          "mail"
        ]
      },
      "InvitationLinkResponse": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string"
          },
          "role": {
            "type": "string",
            "enum": [
              "administrator",
              "editor",
              "member",
              "reader"
            ]
          }
        },
        "required": [
          "email",
          "role"
        ]
      },
      "InvitationResponse": {
        "type": "object",
        "properties": {
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "email": {
            "type": "string"
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          },
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "invitedBy": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
          },
          "role": {
            "type": "string",
            "enum": [
              "administrator",
              "editor",
              "member",
              "reader"
            ]
          }
        },
        "required": [
          "id",
          "email",
          "role",
          "invitedBy",
          "createdAt",
          "expiresAt"
        ]
      },
      "InviteRequest": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string"
          },
          "role": {
            "type": "string",
            "enum": [
              "administrator",
              "editor",
              "member",
              "reader"
            ]
          }
        },
        "required": [
          "email",
          "role"
        ]
      },
      "MetaResponse": {
        "type": "object",
        "properties": {
          "apiVersion": {
            "type": "string"
          },
          "build": {
            "$ref": "#/components/schemas/Info"
          },
          "capabilities": {
            "type": "array",
            "items": {
              "type": "string"
            }
